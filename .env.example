# Create .env with:  python scripts/init_env.py   (fills JWT_SECRET and MASTER_KEY for you)
# NEVER commit .env. Leave secrets empty in this example file.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Secrets (generated by scripts/init_env.py)
JWT_SECRET=
MASTER_KEY=

# Auth
ACCESS_TOKEN_MINUTES=30
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Storage / database (defaults live under ./data, which is git-ignored)
# DATABASE_URL=sqlite:///./data/secureprint.db
# STORAGE_DIR=./data/storage
MAX_UPLOAD_MB=50

CORS_ORIGINS=http://localhost:5173

# auto | low | standard | high  (auto = detect CPU cores / RAM)
HARDWARE_PROFILE=auto

# Optional: one shared password for all seeded demo users (min 10 chars).
# If empty, scripts/seed_database.py generates random passwords and prints them ONCE.
SEED_PASSWORD=
